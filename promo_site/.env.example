# Google Play 계정 삭제 페이지에 표시할 공개 지원 이메일입니다.
# 실제 배포 환경에서는 사용자가 연락할 수 있는 운영 주소로 바꾸세요.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# 선택 사항: 커스텀 도메인을 사용한다면 소셜 공유 메타데이터용 주소를 지정합니다.
# 미설정 시 Netlify가 제공하는 URL 환경변수를 사용합니다.
NEXT_PUBLIC_SITE_URL=https://your-site.example
# 테스터 게시판 관리자 로그인 비밀번호(10자 이상)입니다.
FEEDBACK_ADMIN_PASSWORD=change-this-admin-password

# 관리자 로그인 쿠키 서명용 무작위 문자열(32자 이상)입니다.
FEEDBACK_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
